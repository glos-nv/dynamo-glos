# Independent runtime for the FLUX example with AI Tune.
FROM nvidia/cuda:13.1.1-devel-ubuntu24.04 AS aitune

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3-dev python3-venv libucx0 \
    build-essential pkg-config libssl-dev libnuma-dev libprotobuf-dev \
    protobuf-compiler libclang-dev \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20260816ubuntu0.24.04.1 \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /bin/
ENV UV_LINK_MODE=copy VIRTUAL_ENV=/opt/dynamo/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
RUN uv venv "$VIRTUAL_ENV" --python 3.12 \
 && uv pip install certifi==2026.10.23 pip==26.2.2 setuptools wheel packaging ninja psutil uvloop \
 && uv pip install torch==2.11.0 torchvision==0.26.0 \
    --index-url https://download.pytorch.org/whl/cu130

# Install FLUX dependencies explicitly instead of inheriting a video runtime.
RUN uv pip install diffusers==0.42.1 transformers==5.22.1 accelerate==1.0.1 \
    pillow==11.3.0 sentencepiece==0.2.3 safetensors==0.8.0 torchao==0.16.0

# Build Dynamo from this checkout for the FLUX worker's image-accounting API.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:${PATH}
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
 && sh /tmp/rustup.sh -y --profile minimal --default-toolchain 1.96.1
RUN uv pip install maturin patchelf
WORKDIR /opt/dynamo
COPY --from=dynamo-src /.cargo/ .cargo/
COPY --from=dynamo-src /Cargo.toml /Cargo.lock /rust-toolchain.toml /pyproject.toml /hatch_build.py /README.md /LICENSE ./
COPY --from=dynamo-src /lib/ lib/
COPY --from=dynamo-src /components/ components/
COPY --from=dynamo-src /examples/router/custom-policy-example/ examples/router/custom-policy-example/
COPY --from=dynamo-src /deploy/inference-gateway/ext-proc/ deploy/inference-gateway/ext-proc/
COPY --from=dynamo-src /deploy/inference-gateway/sidecar/ deploy/inference-gateway/sidecar/
ARG CUDA_ARCHS=89
ENV CARGO_BUILD_JOBS=12 CARGO_TARGET_DIR=/opt/target CUDA_ARCHS=${CUDA_ARCHS}
RUN --mount=type=cache,target=/opt/cargo/registry \
    --mount=type=cache,target=/opt/cargo/git \
    --mount=type=cache,target=/opt/target \
    maturin build --release --locked --auditwheel skip --manifest-path lib/bindings/python/Cargo.toml --out /opt/wheels
RUN uv pip install /opt/wheels/*.whl .
WORKDIR /opt/app

# Install the published AI Tune release.
RUN uv pip install 'aitune[torch211]==0.6.0' 'torch==2.11.0' \
    --extra-index-url https://pypi.nvidia.com --index-strategy unsafe-best-match
ENV AITUNE_CACHE_DIR=/root/.cache/huggingface/aitune
ENV TORCHINDUCTOR_CACHE_DIR=/root/.cache/huggingface/inductor
ENV TRITON_CACHE_DIR=/root/.cache/huggingface/triton
COPY . /opt/app/
